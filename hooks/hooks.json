{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "statusMessage": "Loading Codex Speak rules"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/permission_request.py\"",
            "statusMessage": "Preparing approval alert"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${PLUGIN_DATA}/runtime-hooks/stop_launcher.py\" ]; then python3 -B \"${PLUGIN_DATA}/runtime-hooks/stop_launcher.py\"; else python3 -B \"${PLUGIN_ROOT}/hooks/stop.py\"; fi"
          }
        ]
      }
    ]
  }
}
